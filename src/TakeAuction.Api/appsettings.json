{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=takeauction;Username=takeauction;Password=takeauction_dev_pw",
    "Redis": "localhost:6379",
    "RabbitMq": "amqp://takeauction:takeauction_dev_pw@localhost:5672"
  },
  "Cache": {
    "InstanceName": "takeauction:",
    "AuctionListTtlSeconds": 30,
    "AuctionDetailTtlSeconds": 60
  },
  "RealTime": {
    "ChannelPrefix": "takeauction:signalr",
    "KeepAliveSeconds": 15,
    "ClientTimeoutSeconds": 30
  },
  "Jobs": {
    "ServerEnabled": true,
    "SchemaName": "hangfire",
    "WorkerCount": 4,
    "QueuePollIntervalSeconds": 5,
    "ExpireAuctionsCron": "* * * * *",
    "ExpireAuctionsBatchSize": 200
  },
  "MessageBroker": {
    "EndpointPrefix": "takeauction",
    "PrefetchCount": 16,
    "RetryCount": 3,
    "RetryIntervalSeconds": 2
  },
  "Jwt": {
    "Issuer": "TakeAuction",
    "Audience": "TakeAuction.Client",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0,
    "AuthPermitLimit": 5,
    "AuthWindowSeconds": 60
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Seed": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
