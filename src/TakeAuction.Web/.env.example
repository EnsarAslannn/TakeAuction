# Leave both unset in development — vite.config.ts proxies /api and /hubs to http://localhost:5080.
VITE_API_BASE=/api/v1
VITE_HUB_URL=/hubs/auctions

# On Vercel, VITE_API_BASE stays relative: vercel.json rewrites /api and /uploads to Railway,
# so the browser sees one origin and the auth cookies stay first-party.
#
# The hub cannot go through that rewrite — Vercel does not proxy WebSocket upgrades — so it
# points straight at Railway and needs the absolute URL:
#
#   VITE_HUB_URL=https://<your-api>.up.railway.app/hubs/auctions
