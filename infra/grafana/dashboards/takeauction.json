    {
      "id": 10,
      "type": "timeseries",
      "title": "Passes through the retry loop",
      "description": "How many trips through the optimistic loop each settled bid took. The loop gives up after PlaceBid's MaxAttempts; everything that settled is in these bands.",
      "datasource": {
        "type": "prometheus",
        "uid": "takeauction-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "takeauction-prometheus"
          },
          "expr": "sum(rate(takeauction_bids_attempts_bucket{le=~\"1(\\\\.0)?\"}[$__rate_interval]))",
          "legendFormat": "first pass",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "takeauction-prometheus"
          },
          "expr": "sum(rate(takeauction_bids_attempts_bucket{le=~\"2(\\\\.0)?\"}[$__rate_interval])) - sum(rate(takeauction_bids_attempts_bucket{le=~\"1(\\\\.0)?\"}[$__rate_interval]))",
          "legendFormat": "second pass",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "takeauction-prometheus"
          },
          "expr": "sum(rate(takeauction_bids_attempts_bucket{le=~\"3(\\\\.0)?\"}[$__rate_interval])) - sum(rate(takeauction_bids_attempts_bucket{le=~\"2(\\\\.0)?\"}[$__rate_interval]))",
          "legendFormat": "third pass",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "takeauction-prometheus"
          },
          "expr": "sum(rate(takeauction_bids_attempts_count[$__rate_interval])) - sum(rate(takeauction_bids_attempts_bucket{le=~\"3(\\\\.0)?\"}[$__rate_interval]))",
          "legendFormat": "more than three",
          "refId": "D",
          "range": true
        }
      ],
