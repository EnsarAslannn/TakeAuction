    {
      "id": 2,
      "type": "stat",
      "title": "Accepted bids / s",
      "description": "Bids that won their row-version race and changed the price or the ceiling.",
      "datasource": {
        "type": "prometheus",
        "uid": "takeauction-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "takeauction-prometheus"
          },
          "expr": "sum(rate(takeauction_bids_total{outcome=\"accepted\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Row-version conflicts / s",
      "description": "A SaveChanges that lost to a concurrent writer (xmin moved). The handler reloads and re-evaluates; this is the retry loop doing its job.",
      "datasource": {
        "type": "prometheus",
        "uid": "takeauction-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "takeauction-prometheus"
          },
          "expr": "sum(rate(takeauction_bids_concurrency_conflicts_total[$__rate_interval])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Conflicts per settled bid",
      "description": "How often a bid had to go round the loop once more. High under a single hot lot and harmless while the retry budget holds — the loop absorbs it.",
      "datasource": {
        "type": "prometheus",
        "uid": "takeauction-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "takeauction-prometheus"
          },
          "expr": "(sum(rate(takeauction_bids_concurrency_conflicts_total[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(takeauction_bids_total[$__rate_interval])), 1e-9)",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Retry budget exhausted",
      "description": "Bidders who got a 409 because every pass lost the race. Over the selected range — zero is the claim.",
      "datasource": {
        "type": "prometheus",
        "uid": "takeauction-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "takeauction-prometheus"
          },
          "expr": "sum((increase(takeauction_bids_total{outcome=\"ConcurrencyConflict\"}[$__range]) > 0) or ((takeauction_bids_total{outcome=\"ConcurrencyConflict\"} > 0) and (time() - takeauction_bids_created{outcome=\"ConcurrencyConflict\"} < $__range_s))) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
