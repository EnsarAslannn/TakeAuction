{
  "uid": "takeauction-overview",
  "title": "TakeAuction — concurrency, outbox and dead letters",
  "description": "What the salon is judged by: how the optimistic bidding loop behaves under contention, and whether any integration event is being lost.",
  "tags": [
    "takeauction"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Bidding under contention — optimistic concurrency on the auction row",
